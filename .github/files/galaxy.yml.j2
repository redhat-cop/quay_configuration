---
namespace: {{ collection_namespace }}
name: {{ collection_name }}
version: {{ collection_version }}
readme: README.md
authors:
  - Hervé Quatremain <herve.quatremain@redhat.com>
  - Tom Page <tpage@redhat.com>
description: Ansible modules to manage Quay Container Registry installations
license:
  - GPL-3.0-or-later
tags:
  - application
  - quay
  - registry
repository: {{ collection_repo }}

# The URL to any online docs
documentation: {{ collection_repo }}

# The URL to the home page of the collection/project
homepage: {{ collection_repo }}

# The URL to the collection issue tracker
issues: {{ collection_repo }}/issues

# Files and directories to exclude from the collection artifact (patterns are
# relative to the collection root). Development tooling, CI configuration,
# tests, and changelog fragments are not user-facing and only increase the size
# of execution environments. CHANGELOG.rst is still included.
build_ignore:
  - .*
  - changelogs
  - tests
...
